# 烟厂制丝线物流智能监控平台 —— 后端 systemd 服务单元
#
# ── 目标服务器勘查结论（110.42.236.65 / VM-0-11-ubuntu）──────────────────
#   用户 ubuntu (uid=1000) 具备免密 sudo，systemctl 可用 → 使用系统级 systemd。
#   端口 18080 已被其他项目占用，因此本服务使用 18081，只监听回环地址。
#
# ── 安装 ───────────────────────────────────────────────────────────────
#   sudo cp deployment/systemd/smoking-monitor-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now smoking-monitor-api
#   systemctl status smoking-monitor-api
#
# ── 无 sudo 时的替代方案 ────────────────────────────────────────────────
#   A. 用户级 systemd：
#        mkdir -p ~/.config/systemd/user
#        cp <本文件> ~/.config/systemd/user/
#        删除下面的 User= / Group= 两行
#        systemctl --user daemon-reload && systemctl --user enable --now smoking-monitor-api
#        loginctl enable-linger "$USER"
#   B. tmux（连 systemd 都没有时）：
#        tmux new -d -s smoking 'cd ~/apps/smoking-monitor/backend && \
#          ../venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18081'

[Unit]
Description=Smoking Line Logistics Monitoring API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 使用部署目录的属主，避免 SQLite 数据文件权限问题 ----
User=ubuntu
Group=ubuntu

# ---- 部署目录 ----
WorkingDirectory=/home/ubuntu/apps/smoking-monitor/backend

# ---- 启动命令：只监听回环地址，由 Nginx 反代对外 ----
ExecStart=/home/ubuntu/apps/smoking-monitor/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 18081 \
    --workers 1 \
    --log-level info

# ---- 敏感配置走环境变量文件，不写进仓库 ----
# 该文件权限建议 600，且不得提交到 Git
EnvironmentFile=-/home/ubuntu/apps/smoking-monitor/api.env

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# ---- 异常自动重启 ----
Restart=always
RestartSec=3
StartLimitIntervalSec=0
TimeoutStopSec=15
KillSignal=SIGINT

# ---- 基础加固（保留用户可写部署目录，故不用 ProtectHome=read-only）----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/apps/smoking-monitor

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smoking-monitor-api

[Install]
WantedBy=multi-user.target
