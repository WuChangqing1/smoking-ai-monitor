# 统一换行符：避免 Windows 上检出的脚本在 Linux 上因 CRLF 无法执行
* text=auto eol=lf

# Shell / 服务脚本必须是 LF
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf

# Windows 批处理保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.mp4       binary
*.doc       binary
*.docx      binary
*.db        binary
*.woff      binary
*.woff2     binary
