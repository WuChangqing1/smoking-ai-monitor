# 后端环境变量示例 —— 复制为 .env 后按需修改
#
# 重要：不要把真实密码、Token、SSH 私钥、服务器地址写进仓库。
# 服务器上的敏感配置请使用 /etc/smoking-monitor/api.env（权限 600，不入 Git）。

# ---- 服务监听 ----
# 生产环境保持 127.0.0.1，由 Nginx 反向代理对外，不直接暴露后端
SMOKING_HOST=127.0.0.1
SMOKING_PORT=18080

# ---- 跨域来源（逗号分隔）----
# 开发环境为 Vite 端口；生产环境由 Nginx 同源反代，可留空
SMOKING_CORS_ORIGINS=http://127.0.0.1:15173,http://localhost:15173

# ---- 数据采集频率（原始资料口径：10 Hz）----
SMOKING_DATA_RATE_HZ=10

# ---- 仿真推进间隔（秒）----
SMOKING_TICK_SECONDS=1.0

# ---- 仿真模式开关 ----
# 1 = 使用内置仿真引擎（比赛展示 / 无硬件环境）
# 0 = 接入真实设备数据源（需实现数据源适配器，见 README 第 11 节）
SMOKING_SIMULATION=1

# ---- 运行模式 ----
# video_sync = 监控数据与主监控视频严格同步（正式演示默认）
# automatic  = 平台自动工况循环（开发、测试与逻辑验证）
SMOKING_RUN_MODE=video_sync

# ---- SQLite 数据库位置（默认为 backend/data/smoking.db）----
# SMOKING_DB_PATH=/var/lib/smoking-monitor/smoking.db

# ---- AI 模型服务的管理员令牌 ----
# AI 配置的写接口（改配置 / 连接测试 / 强制重新分析）需要此令牌。
#
# 两个站点都有公网入口，写接口不能匿名开放 ——
# 否则任何人都能改 Base URL、换 Key、消耗模型 Token。
#
# 配置了令牌：请求需带 X-AI-Admin-Token 且匹配。
# 未配置令牌：仅本机（回环）来源可写，公网一律拒绝。
#
# 同时也是 AI API Key 静态加密的密钥来源：更换令牌后
# 已保存的 API Key 需要重新填写（不会退回明文存储）。
#
# 生成方式示例：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 该值只放服务器环境变量，不得提交到仓库。
AI_ADMIN_TOKEN=
